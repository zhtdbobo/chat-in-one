{
  "name": "chat-in-one",
  "version": "1.1.1",
  "description": "chat-in-one",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "clean": "rd /s /q dist",
    "prebuild": "npm run clean",
    "dist": "electron-builder --win",
    "publish": "electron-builder --win --publish always",
    "pack": "electron-builder --win --dir"
  },
  "keywords": [
    "ai",
    "chat",
    "electron"
  ],
  "author": "chat-in-one Dev Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@phosphor-icons/web": "^2.1.2",
    "dompurify": "^3.0.9",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "highlight.js": "^11.9.0",
    "marked": "^4.3.0"
  },
  "build": {
    "appId": "com.chatinone.app",
    "productName": "chat-in-one",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "zhtdbobo",
        "repo": "chat-in-one"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "chat-in-one",
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "installerHeaderIcon": "src/assets/icon.ico"
    },
    "asar": true,
    "files": [
      "**/*",
      "!dist",
      "node_modules/marked/**/*",
      "node_modules/dompurify/**/*",
      "node_modules/highlight.js/**/*",
      "node_modules/@phosphor-icons/web/**/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhtdbobo/chat-in-one.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/zhtdbobo/chat-in-one/issues"
  },
  "homepage": "https://github.com/zhtdbobo/chat-in-one#readme"
}