{
  "name": "chat-in-one",
  "version": "1.0.0",
  "description": "All-in-One AI Assistant Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "clean": "rd /s /q dist",
    "prebuild": "npm run clean",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "keywords": [
    "ai",
    "chat",
    "electron"
  ],
  "author": "Chat-in-One Dev Team",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "electron-store": "^10.0.0"
  },
  "build": {
    "appId": "com.chatinone.app",
    "productName": "Chat-in-One",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chat-in-One",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "asar": true,
    "files": [
      "**/*",
      "!dist",
      "!node_modules",
      "node_modules/**/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhtdbobo/chat-in-one.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/zhtdbobo/chat-in-one/issues"
  },
  "homepage": "https://github.com/zhtdbobo/chat-in-one#readme"
}